# =============================================================================
# Maceut — Root Environment Variables (untuk docker-compose.yml)
# Copy ke .env di root project. File ini HANYA untuk variabel yang dibagi
# antar service di docker-compose.yml (misal kredensial postgres).
#
# ⛔ KUNCI HERE DAN R2 TIDAK ADA DI SINI. Lihat api/.env.example.
#
#    Ada TIGA file env, masing-masing dibaca pihak yang berbeda:
#
#      .env (file ini)   → hanya di-interpolasi docker-compose.yml untuk MEMBUAT
#                          container postgres. Sengaja kecil.
#      api/.env          → HERE, R2, JWT, RabbitMQ, Playwright, CORS (38 key).
#                          Dibaca proses api & worker. Isi kredensial DI SINI:
#                            cd api && npm run env:set -- HERE_API_KEY
#      web/.env.local    → hanya NEXT_PUBLIC_*, ikut ter-bundle ke browser.
#
#    Kredensial pihak ketiga tidak diletakkan di file ini supaya tidak masuk ke
#    scope interpolasi SEMUA service di compose, melainkan hanya ke service yang
#    memang membutuhkannya.
#
# ⚠️ DB_NAME / DB_USER / DB_PASSWORD di sini dipakai untuk MEMBUAT database saat
#    container postgres pertama kali start, dan HARUS sama persis dengan nilai
#    di api/.env yang dipakai API untuk MENYAMBUNG. Kalau beda, postgres tetap
#    healthy tapi API gagal "password authentication failed".
#
#    Catatan: mengganti DB_PASSWORD di sini TIDAK mengubah password di database
#    yang sudah terlanjur dibuat — volume postgres_data hanya di-inisialisasi
#    sekali. Untuk benar-benar reset: `docker compose down -v`.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (dipakai oleh service `postgres` di docker-compose.yml)
# -----------------------------------------------------------------------------
DB_NAME=maceut_dev
DB_USER=postgres
DB_PASSWORD=your_password_here

# -----------------------------------------------------------------------------
# RabbitMQ (dipakai service `rabbitmq`). HARUS sama dengan user:password di
# RABBITMQ_URL api/.env. Kosong = guest/guest (cukup untuk lokal). Produksi: isi.
# Seperti DB_PASSWORD, hanya berlaku saat volume rabbitmq_data pertama dibuat.
# -----------------------------------------------------------------------------
RABBITMQ_USER=
RABBITMQ_PASS=

# -----------------------------------------------------------------------------
# Produksi lewat Traefik host (docker-compose.traefik.yml): domain web dan API.
# -----------------------------------------------------------------------------
WEB_HOST=
API_HOST=

# -----------------------------------------------------------------------------
# Docker Compose project name (opsional, untuk isolasi antar environment)
# -----------------------------------------------------------------------------
# Produksi di host yang sama dengan dev: pakai nama lain (maceut-prod), supaya
# container dan volume (database!) produksi tidak tertukar dengan milik dev.
COMPOSE_PROJECT_NAME=maceut
