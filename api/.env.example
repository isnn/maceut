# =============================================================================
# Maceut API — Environment Variables
# Copy file ini ke .env dan isi nilainya. Jangan commit .env ke git.
#
# ⚠️ DB_NAME / DB_USER / DB_PASSWORD di file ini HARUS sama persis dengan yang
#    ada di .env root project. Root .env dipakai untuk MEMBUAT database di
#    container postgres; file ini dipakai API untuk MENYAMBUNG ke database itu.
#    Kalau beda: postgres tetap healthy, API gagal dengan "password
#    authentication failed" tanpa petunjuk jelas.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
NODE_ENV=development          # development | production
PORT=8080
APP_BASE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Database — PostgreSQL + PostGIS (Drizzle)
# -----------------------------------------------------------------------------
DB_HOST=postgres               # nama service di docker-compose (pakai 'localhost' jika run manual di luar Docker)
DB_PORT=5432
DB_NAME=maceut_dev
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSLMODE=disable             # disable | require (production: require)

# Opsional. Kosongkan untuk membiarkan config menyusunnya sendiri dari DB_* di
# atas — itu yang direkomendasikan supaya tidak ada dua sumber kebenaran yang
# bisa berbeda diam-diam. Diisi HANYA kalau butuh connection string khusus
# (misal managed Postgres dengan parameter tambahan). drizzle-kit membaca nilai
# hasil derivasi ini lewat drizzle.config.ts.
DATABASE_URL=

# Connection pool
DB_POOL_MAX=25
DB_POOL_IDLE_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Auth — Better Auth (session + HttpOnly cookie, ADR-009)
# -----------------------------------------------------------------------------
# Dipakai Better Auth untuk menandatangani sesi. Mengganti nilai ini membuat SEMUA
# sesi aktif langsung tidak valid (semua user ter-logout).
JWT_SECRET=your_jwt_secret_minimum_32_chars_here
JWT_EXPIRY=7d                  # umur sesi, 7 hari

# Email staf Maceut yang otomatis punya platform role `internal` (BR-027),
# dipisah koma. Kosongkan untuk mematikan akses /internal sepenuhnya.
#
# Ini yang menentukan sebenarnya — berbeda dengan NEXT_PUBLIC_INTERNAL_EMAILS di
# web/ yang ikut ter-bundle ke browser dan hanya mengatur apa yang dirender.
# Role di database hanya cache: setiap request di-resolve ulang dari daftar ini,
# jadi menghapus email di sini langsung mencabut akses, termasuk untuk sesi yang
# sudah berjalan. Perubahan butuh restart service.
INTERNAL_EMAILS=admin@maceut.id,ops@maceut.id

COOKIE_DOMAIN=localhost        # production: yourdomain.com
COOKIE_SECURE=false            # production: true
COOKIE_SAME_SITE=lax           # strict | lax | none

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_QUEUE_CAPTURE=capture-jobs
RABBITMQ_QUEUE_DEAD_LETTER=capture-dead-letter

# -----------------------------------------------------------------------------
# Cloudflare R2 — penyimpanan capture & logo (ADR-008)
# -----------------------------------------------------------------------------
# Cara mendapatkan, di dash.cloudflare.com:
#
#   1. R2 → Create bucket. Nama bucket = R2_BUCKET_NAME.
#   2. R2 → Overview. "Account ID" di panel kanan = R2_ACCOUNT_ID.
#   3. R2 → Manage R2 API Tokens → Create API token.
#      ⚠️ Permission WAJIB "Object Read & Write", BUKAN "Object Read only".
#         Token read-only tetap LOLOS pengecekan bucket lalu gagal di setiap
#         upload — `npm run env:check` sengaja melakukan put/get/presign/delete
#         penuh supaya kesalahan ini ketahuan sekarang, bukan saat worker jalan.
#      Setelah dibuat: "Access Key ID" = R2_ACCESS_KEY_ID,
#                      "Secret Access Key" = R2_ACCESS_KEY_SECRET.
#         (Secret hanya ditampilkan SEKALI. Kalau hilang, buat token baru.)
#   4. R2_PUBLIC_URL: bucket → Settings → Public access. Kalau dibiarkan
#      private, kosongkan saja — capture akan dikirim lewat presigned URL.
#      env:check melaporkan mana yang benar-benar jalan.
#
# Catatan nama: R2_ACCESS_KEY_SECRET (bukan R2_SECRET_ACCESS_KEY ala AWS) —
# nama ini dipakai juga di katalog config frontend, jadi biarkan apa adanya.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_ACCESS_KEY_SECRET=your_r2_access_key_secret
R2_BUCKET_NAME=maceut-captures
R2_PUBLIC_URL=https://your-r2-public-url.r2.dev  # atau custom domain

# Opsional. Normalnya endpoint diturunkan dari R2_ACCOUNT_ID menjadi
# https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com — isi ini HANYA kalau bucket
# dibuat dengan jurisdiction tertentu (EU memakai host .eu.r2.cloudflarestorage.com)
# atau saat menunjuk ke emulator S3 lokal.
R2_ENDPOINT=

# -----------------------------------------------------------------------------
# HERE Traffic Flow (data only — basemap tile pakai OpenStreetMap, ADR-010b)
# -----------------------------------------------------------------------------
# Cara mendapatkan, di platform.here.com:
#
#   1. Buat project, lalu Access Manager → Apps → Create app.
#   2. Di app tersebut: "Create API key". Nilainya = HERE_API_KEY.
#   3. ⚠️ Pastikan produk "Traffic" AKTIF untuk app itu. Key yang valid tapi
#      tanpa Traffic membalas 401 — persis sama dengan key yang salah. Kalau
#      env:check melaporkan 401, periksa daftar produk app-nya dulu sebelum
#      menyimpulkan nilainya keliru.
#
# Key ini TIDAK PERNAH dikirim ke browser: frontend memanggil
# GET /traffic/preview dan backend yang meneruskan ke HERE (ADR-010).
#
# ⚠️ Berbayar per request. `npm run env:check` memanggil HERE 2x (satu probe
# biasa, satu untuk menguji apakah filter functionalClasses diterima).
HERE_API_KEY=your_here_api_key_here
HERE_TRAFFIC_FLOW_URL=https://data.traffic.hereapi.com/v7/flow

# -----------------------------------------------------------------------------
# OpenStreetMap (basemap tile, dipakai juga di internal render page untuk Playwright)
# -----------------------------------------------------------------------------
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# -----------------------------------------------------------------------------
# Playwright (Capture Engine)
# -----------------------------------------------------------------------------
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_SCREENSHOT_WIDTH=1280
PLAYWRIGHT_SCREENSHOT_HEIGHT=720
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium  # dipakai di Docker (Alpine)

# -----------------------------------------------------------------------------
# Frontend — dua URL berbeda, jangan disatukan (ADR-017)
# -----------------------------------------------------------------------------
# Origin yang dipakai BROWSER. Dipakai untuk CORS allow-origin, jadi harus persis
# sama dengan yang ada di address bar (skema + host + port), bukan alamat internal.
FRONTEND_URL=http://localhost:3000

# Base URL yang dipakai PLAYWRIGHT dari dalam container api untuk membuka
# internal render page ({RENDER_BASE_URL}/internal/render/capture?...).
# Di docker-compose ini adalah nama service web, bukan localhost — 'localhost'
# di dalam container api menunjuk ke container api itu sendiri.
RENDER_BASE_URL=http://web:3000

# -----------------------------------------------------------------------------
# Swagger
# -----------------------------------------------------------------------------
SWAGGER_ENABLED=true           # false di production jika ingin disable UI
