# =============================================================================
# Maceut API + worker — PRODUCTION (maceut.hokya.dev)
# On the server: cp api/.env.production.example api/.env, then fill every <...>.
# Never commit the filled file. Guide: docs/operations/deploy.md
#
# Moving to another domain (e.g. maceut.com) = change APP_BASE_URL, FRONTEND_URL and
# COOKIE_DOMAIN here (maceut.com + api.maceut.com), plus web/.env.production, then rebuild. Nothing in the code changes.
# =============================================================================

NODE_ENV=production
PORT=8080

# Public address of THIS API (Better Auth builds its callback URLs from it).
APP_BASE_URL=https://maceut-api.hokya.dev

# The web app's address: the only origin CORS and Better Auth accept, and the base of
# every link in emails. Exactly one origin, https, no trailing slash.
FRONTEND_URL=https://maceut.hokya.dev

# Session cookie. It is set by the API host. Web (maceut.hokya.dev) and API
# (maceut-api.hokya.dev) are the same site (hokya.dev), so SameSite=lax cookies travel
# with the browser's credentialed requests.
COOKIE_DOMAIN=maceut-api.hokya.dev
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# --- Database (the compose `postgres` service; must match the root .env) -----
DB_HOST=postgres
DB_PORT=5432
DB_NAME=maceut
DB_USER=maceut
DB_PASSWORD=<long random password>
DB_SSLMODE=disable             # require when using a managed database
DATABASE_URL=
DB_POOL_MAX=25
DB_POOL_IDLE_TIMEOUT_MS=30000

# --- Auth ----------------------------------------------------------------------
JWT_SECRET=<64 random chars: openssl rand -hex 32>
JWT_EXPIRY=7d
INTERNAL_EMAILS=<your staff email(s), comma-separated>

# --- Queue ---------------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_QUEUE_CAPTURE=capture-jobs
RABBITMQ_QUEUE_EXPORT=export-jobs
RABBITMQ_QUEUE_RENDER=render-jobs
RABBITMQ_QUEUE_DEAD_LETTER=capture-dead-letter

# Off until `retention:dry-run` has been read on the production data (ADR-035).
RETENTION_SWEEPER_ENABLED=false

# --- Storage (Cloudflare R2) ---------------------------------------------------
R2_ACCOUNT_ID=<cloudflare account id>
R2_ACCESS_KEY_ID=<r2 access key id>
R2_ACCESS_KEY_SECRET=<r2 secret>
R2_BUCKET_NAME=maceut-captures
R2_PUBLIC_URL=                 # empty = private bucket, served by presigned URL
R2_ENDPOINT=

# --- Traffic -------------------------------------------------------------------
HERE_API_KEY=<here api key>
HERE_TRAFFIC_FLOW_URL=https://data.traffic.hereapi.com/v7/flow
# Pencarian tempat di peta zona: HERE Geocoding sampai sekian pencarian per bulan (free tier
# HERE 5.000), sesudahnya OpenStreetMap Nominatim. Lihat services/geocode.service.ts.
HERE_GEOCODE_MONTHLY_LIMIT=4000
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# --- Capture / export engine (paths match the production image) ----------------
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_SCREENSHOT_WIDTH=1280
PLAYWRIGHT_SCREENSHOT_HEIGHT=720
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
FFMPEG_PATH=ffmpeg
EXPORT_TMP_DIR=/tmp/maceut-exports
# The worker opens the render page inside the compose network, not through the domain.
RENDER_BASE_URL=http://web:3000

# --- Email ---------------------------------------------------------------------
# auto: Mailtrap sends, Resend takes over when it fails. The EMAIL_FROM domain must be
# verified in both. Mailtrap logs: https://mailtrap.io/sending/email_logs
EMAIL_PROVIDER=auto
EMAIL_FROM=Maceut <no-reply@hokya.dev>
MAILTRAP_API_TOKEN=<mailtrap api token>
RESEND_API_KEY=<resend api key>
MAILTRAP_INBOX_ID=

SWAGGER_ENABLED=false
