# =============================================================================
# Maceut Web — PRODUCTION (maceut.hokya.dev)
# On the server: cp web/.env.production.example web/.env.production
#
# NEXT_PUBLIC_* are baked into the browser bundle by `next build`: after changing any of
# them, REBUILD (`docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build web`).
# =============================================================================

# Browser → API. Must be https: an https page cannot call an http address.
NEXT_PUBLIC_API_BASE_URL=https://maceut-api.hokya.dev
# Server-side calls stay inside the compose network.
API_BASE_URL=http://api:8080

# Absolute links (Open Graph image, canonical URLs).
NEXT_PUBLIC_APP_URL=https://maceut.hokya.dev
NEXT_PUBLIC_APP_ENV=production

NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_OSM_ATTRIBUTION=© OpenStreetMap contributors
NEXT_PUBLIC_ENABLE_MOCK_CAPTURE=false
