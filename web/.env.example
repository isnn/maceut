# =============================================================================
# Maceut Web — Environment Variables
# Copy file ini ke .env.local dan isi nilainya. Jangan commit .env.local ke git.
# Next.js membaca .env.local secara otomatis.
# =============================================================================

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
# Digunakan oleh Next.js Server Components dan API routes (server-side)
API_BASE_URL=http://localhost:8080

# Digunakan oleh browser (client-side fetch) — wajib prefix NEXT_PUBLIC_
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Basemap — OpenStreetMap (client-side, via Leaflet)
# -----------------------------------------------------------------------------
# Tidak perlu API key untuk tile OSM standar. Traffic data (HERE Traffic Flow)
# diambil lewat proxy backend (GET /traffic/preview) — HERE API key hanya
# disimpan di api/.env, tidak pernah diekspos ke browser.
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_OSM_ATTRIBUTION=© OpenStreetMap contributors

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development    # development | production

# -----------------------------------------------------------------------------
# Feature Flags (opsional, aktifkan untuk testing)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_MOCK_CAPTURE=false   # true = skip Playwright, return dummy image
