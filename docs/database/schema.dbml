// =============================================================================
// Maceut — database schema (DBML)
//
// Paste into https://dbdiagram.io to view the ERD.
//
// ⚠️ This file is documentation, not a source of truth. The schema is defined in
//    api/drizzle/schema.ts and api/drizzle/auth-schema.ts, and applied by the
//    migrations in api/drizzle/migrations/. Update this file in the SAME commit
//    that changes those — a stale ERD is worse than none, because it is believed.
//
// Convention: every timestamp is `timestamptz`. A bare `timestamp` carries no
// offset and means whatever the reading process assumes.
//
// Last updated: 2026-09-28 (migration 0013_notifications; 0012 was data-only — existing users marked email_verified)
// =============================================================================

Project maceut {
  database_type: 'PostgreSQL'
  Note: 'Traffic monitoring and scheduled capture platform. PostGIS required.'
}

// -----------------------------------------------------------------------------
// Better Auth — generated by `npx @better-auth/cli generate` (ADR-009)
// Do not hand-edit api/drizzle/auth-schema.ts except to re-apply withTimezone.
// -----------------------------------------------------------------------------

Table user {
  id text [pk]
  name text [not null, note: 'Full name. Surfaced to the app as fullName.']
  email text [not null, note: 'UNIQUE on lower(email) — see migration 0001']
  email_verified boolean [not null, default: false]
  image text [null]
  role text [null, default: 'user', note: 'Platform role: user | internal (BR-027). Cache — INTERNAL_EMAILS is the authority and acts as a floor, never a ceiling.']
  onboarding_done boolean [null, default: false, note: 'Server-set only (input: false)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (email) [unique, name: 'user_email_lower_unique', note: 'Functional index on lower(email)']
  }
}

Table session {
  id text [pk]
  expires_at timestamptz [not null, note: 'Server-side expiry — sign-out genuinely revokes']
  token text [not null, unique]
  ip_address text [null]
  user_agent text [null]
  user_id text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  Indexes {
    user_id [name: 'session_userId_idx']
  }
}

Table account {
  id text [pk]
  account_id text [not null]
  provider_id text [not null]
  user_id text [not null]
  access_token text [null]
  refresh_token text [null]
  id_token text [null]
  access_token_expires_at timestamptz [null]
  refresh_token_expires_at timestamptz [null]
  scope text [null]
  password text [null, note: 'scrypt hash for email/password accounts']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  Indexes {
    user_id [name: 'account_userId_idx']
  }
}

Table verification {
  id text [pk]
  identifier text [not null]
  value text [not null]
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    identifier [name: 'verification_identifier_idx']
  }
}

// -----------------------------------------------------------------------------
// Application tables — api/drizzle/schema.ts
// -----------------------------------------------------------------------------

Table user_plans {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id text [not null, unique, note: '1:1 with user']
  plan plan [not null, default: 'free', note: 'BR-001: every account starts free']
  started_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [null, note: 'NULL = active indefinitely; billing not implemented']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    user_id [name: 'user_plans_user_id_idx']
  }
}

Table zones {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id text [not null]
  name text [not null]
  road_class road_class [not null, note: 'BR-020 chosen at creation, BR-029 editable after']
  status zone_status [not null, default: 'collecting']
  paused_by_plan boolean [not null, default: false, note: 'Paused by a plan change (ADR-020), not the user. Cleared by any other status change (0011)']
  geometry "geometry(Polygon,4326)" [not null, note: 'PostGIS, WGS84 (BR-013). Added by migration 0003 — no Drizzle type exists. Read/written via ST_AsGeoJSON / ST_GeomFromGeoJSON (ADR-011). areaKm2 is COMPUTED on read, never stored.']
  roads_count integer [null, note: 'From HERE. NULL = not known yet, NOT zero.']
  length_km "numeric(10,2)" [null, note: 'From HERE. NULL = not known yet.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, name) [unique, name: 'zones_user_id_name_unique', note: 'BR-015']
    user_id [name: 'zones_user_id_idx']
    geometry [type: gist, name: 'zones_geometry_idx']
  }
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

Enum plan {
  free
  standard
  premium
}

Enum capture_interval {
  "15min" [note: 'Premium only']
  hourly  [note: 'Standard and up']
  daily   [note: 'All plans']
}

Enum schedule_status {
  active
  paused  [note: 'Frees its BR-005 slot. Also what a downgrade does (ADR-020)']
  deleted [note: 'Soft delete — capture history references the schedule']
}

Enum platform_role {
  user
  internal
}

Enum road_class {
  nasional          [note: 'HERE FC1-2']
  nasional_provinsi [note: 'HERE FC1-3']
  semua             [note: 'HERE FC1-5']
}

Enum zone_status {
  collecting
  paused
}

// -----------------------------------------------------------------------------
// Relationships
// -----------------------------------------------------------------------------

Ref: session.user_id > user.id [delete: cascade]
Ref: account.user_id > user.id [delete: cascade]
Ref: user_plans.user_id - user.id [delete: cascade]
Ref: zones.user_id > user.id [delete: cascade]

Table schedules {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id text [not null]
  zone_id uuid [not null]
  label text [not null]
  start_time text [not null, note: '"HH:mm" in Asia/Jakarta']
  end_time text [not null]
  interval capture_interval [not null]
  days "integer[]" [not null, note: '0 = Monday … 6 = Sunday']
  status schedule_status [not null, default: 'active']
  paused_by_plan boolean [not null, default: false, note: 'As zones.paused_by_plan (0011)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  next_fire_at timestamptz [note: 'The next instant this window is due. Claimed with UPDATE ... RETURNING / FOR UPDATE SKIP LOCKED, so a restart resumes and a second replica is safe (0008)']

  Note: 'Stored as a WINDOW, not cron (ADR-019). Window -> cron is total; cron -> window is not, so the lossy direction happens in memory. See api/src/types/schedule.ts'

  Indexes {
    user_id [name: 'schedules_user_id_idx']
    zone_id [name: 'schedules_zone_id_idx']
    (user_id, status) [name: 'schedules_user_status_idx', note: 'BR-005 counts active only']
    next_fire_at [name: 'schedules_due_idx', note: 'Partial: active windows only (0008)']
    id [name: 'schedules_unseeded_idx', note: 'Partial: active AND next_fire_at IS NULL (0008)']
  }
}

Ref: schedules.user_id > user.id [delete: cascade]
Ref: schedules.zone_id > zones.id [delete: cascade]

// -----------------------------------------------------------------------------
// Captures — one row per cycle a zone collects (0007). Added to this file late:
// 0007 and 0008 shipped without their DBML update, caught and fixed with 0009.
// -----------------------------------------------------------------------------

Enum capture_status {
  pending
  processing
  done
  failed
  skipped_limit [note: 'BR-008 — refused by the daily limit, recorded not retried']
  missed [note: 'The system was down when this was due. Not attempted, so not a failure']
}

Enum capture_trigger {
  manual
  scheduled
}

Table captures {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id text [not null]
  zone_id uuid [not null]
  schedule_id uuid [note: 'SET NULL on schedule delete — the frame still happened']
  status capture_status [not null, default: 'pending']
  trigger capture_trigger [not null]
  road_class road_class [not null, note: 'Class actually collected, after BR-022 cap']
  traffic jsonb [note: 'HERE FeatureCollection, clipped to the zone polygon']
  roads_count integer
  jam_factor_avg "numeric(4,2)"
  file_path text [note: 'BR-011 R2 path. Null until CAP-02 renders an image']
  file_size integer
  style_used jsonb [note: 'BR-023 — history only']
  error text
  scheduled_for timestamptz [note: 'When the cycle was due; null for manual']
  captured_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (zone_id, captured_at) [name: 'captures_zone_captured_idx']
    (user_id, captured_at) [name: 'captures_user_captured_idx', note: 'BR-006 daily count']
    schedule_id [name: 'captures_schedule_idx']
  }
}

Ref: captures.user_id > user.id [delete: cascade]
Ref: captures.zone_id > zones.id [delete: cascade]
Ref: captures.schedule_id > schedules.id [delete: set null]

// -----------------------------------------------------------------------------
// Exports — Studio ZIP/WebM rendered by the worker (FE-21, 0009)
// -----------------------------------------------------------------------------

Enum export_format {
  zip
  webm
}

Enum export_status {
  queued
  rendering
  uploading
  done
  failed
  expired [note: 'File deleted after retention; row kept as history']
}

Table exports {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id text [not null]
  zone_id uuid [not null]
  format export_format [not null]
  status export_status [not null, default: 'queued']
  spec jsonb [not null, note: 'Render settings as Studio showed them; themes by id']
  frame_ids jsonb [not null, note: 'Capture ids, frozen at request time']
  frame_count integer [not null]
  frames_done integer [not null, default: 0, note: 'Written by the worker as it renders — the progress bar']
  file_path text [note: 'R2 path; null until uploaded and again once expired']
  file_size integer
  error text
  created_at timestamptz [not null, default: `now()`]
  started_at timestamptz
  updated_at timestamptz [not null, default: `now()`, note: 'Heartbeat — a stale render is swept to failed']
  finished_at timestamptz
  expires_at timestamptz

  Indexes {
    (zone_id, created_at) [name: 'exports_zone_created_idx']
    (user_id, status) [name: 'exports_user_status_idx', note: 'One active export per user']
    status [name: 'exports_status_idx', note: 'Sweeper scans']
  }
}

Ref: exports.user_id > user.id [delete: cascade]
Ref: exports.zone_id > zones.id [delete: cascade]

// -----------------------------------------------------------------------------
// HERE usage & platform settings — admin budget cap (ADM-01, ADR-025, 0010)
// -----------------------------------------------------------------------------

Table here_usage {
  day date [not null, note: 'WIB calendar day the calls fell on']
  source text [not null, note: 'capture · preview · road_counts · zone_stats']
  requests integer [not null, default: 0, note: 'Calls sent to HERE']
  failed integer [not null, default: 0, note: 'Sent but failed (network or HERE error)']
  refused integer [not null, default: 0, note: 'Stopped by the budget cap before sending — not billed']
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (day, source) [pk]
  }
}

Table platform_settings {
  key text [pk, note: 'e.g. here_budget']
  value jsonb [not null]
  updated_at timestamptz [not null, default: `now()`]
  updated_by text [note: 'SET NULL on user delete']

  Note: 'Runtime-editable operational values staff change without a restart. Not secrets (ADR-018 keeps .env read-only).'
}

Ref: platform_settings.updated_by > user.id [delete: set null]

// -----------------------------------------------------------------------------
// Notifications (NOTIF) — migration 0013
// -----------------------------------------------------------------------------

Enum notification_type {
  capture_failing
  capture_recovered
  captures_missed
  capture_limit_reached
  capture_limit_near
  export_ready
  export_failed
  plan_changed
  here_budget_warning [note: 'Staff only']
  here_budget_reached [note: 'Staff only']
}

Enum notification_tone {
  warning
  success
  info
}

Enum notification_email_status {
  none [note: 'In-app only (most types)']
  pending [note: 'May email at email_due_at — the sweep decides']
  sent
  skipped [note: 'Reason in email_skip_reason: read in app, resolved, switched off, daily cap']
}

Table notifications {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id text [not null]
  type notification_type [not null]
  tone notification_tone [not null]
  title text [not null]
  body text [not null]
  action_label text
  action_href text
  data jsonb [not null, default: `'{}'`, note: 'zoneId / captureId / exportId behind the message']
  dedupe_key text [not null, note: 'Same event twice inserts nothing']
  read_at timestamptz
  email_status notification_email_status [not null, default: 'none']
  email_due_at timestamptz
  email_attempts integer [not null, default: 0]
  emailed_at timestamptz
  email_skip_reason text
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, dedupe_key) [unique, name: 'notifications_user_dedupe_uq']
    (user_id, created_at) [name: 'notifications_user_created_idx']
    (email_status, email_due_at) [name: 'notifications_email_due_idx']
  }

  Note: 'The bell. Deleted after 90 days by the sweeper.'
}

Ref: notifications.user_id > user.id [delete: cascade]

Table notification_preferences {
  user_id text [pk]
  email_capture_problems boolean [not null, default: true]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'One email switch per user; no row = defaults'
}

Ref: notification_preferences.user_id - user.id [delete: cascade]

Enum email_log_status {
  sent
  failed
  suppressed [note: 'A send limit said no']
}

Table email_log {
  id uuid [pk, default: `gen_random_uuid()`]
  to text [not null]
  category text [not null, note: 'email-verification, forget-password, capture-problems, plan-changed, here-budget']
  dedupe_key text [unique, note: 'Alerts that must go out once']
  status email_log_status [not null]
  provider text [not null]
  error text
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (to, category, created_at) [name: 'email_log_to_category_created_idx']
  }

  Note: 'Every email attempted — cost meter and OTP send limits. Never the body or a code.'
}

// -----------------------------------------------------------------------------
// Not built yet — listed so the gap is visible rather than forgotten
// -----------------------------------------------------------------------------
